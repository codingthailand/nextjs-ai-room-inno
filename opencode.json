{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail"],
  "subagent_depth": 3,
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash": {
      "git add *": "allow",
      "git commit -m *": "allow",
      "git push": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "external_directory": "ask"
    }
  }
}